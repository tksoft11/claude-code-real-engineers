{
  "permissions": {
    "allow": [
      "Read(**)",
      "Write(src/**)",
      "Write(tests/**)",
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(git *)"
    ],
    "deny": [
      "Bash(git push --force)",
      "Bash(npm run deploy:production)",
      "Write(.env*)",
      "Write(prisma/migrations/**)"
    ]
  }
}
